# ---------------------------------------------------------------------------
# ReachPilot environment
# Copy to .env.local for development. Everything here is optional: with no
# keys the app runs on the guided local model and the private demo outbox.
# Never commit .env.local or real credentials.
# ---------------------------------------------------------------------------

# --- Claude (recommended) ---------------------------------------------------
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Optional model override. Defaults to claude-sonnet-4-5.
ANTHROPIC_MODEL=

# --- Or: Vercel AI Gateway --------------------------------------------------
# Used automatically when ANTHROPIC_API_KEY is not set.
AI_GATEWAY_API_KEY=
# Optional model override. Defaults to anthropic/claude-sonnet-4.5.
AI_GATEWAY_MODEL=

# --- Gmail (optional) -------------------------------------------------------
# Create an OAuth 2.0 Web application in Google Cloud, enable the Gmail API,
# then run: npm run gmail:auth
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=
# Optional display name used in the From header.
GMAIL_SENDER_NAME=

# --- Workspace storage (optional in dev, recommended on Vercel) -------------
# Create a private Vercel Blob store and connect it to the project. The token
# is injected automatically by Vercel. Locally, data is saved to .data/.
BLOB_READ_WRITE_TOKEN=
# Only needed when using OIDC instead of a read/write token.
BLOB_STORE_ID=

# --- Automation -------------------------------------------------------------
# Protects /api/cron/tick. Set the same value in Vercel Cron or n8n.
CRON_SECRET=
