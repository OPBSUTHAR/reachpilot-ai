{
  "name": "ReachPilot daily check",
  "active": false,
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "daysInterval": 1,
              "triggerAtHour": 9,
              "triggerAtMinute": 0
            }
          ]
        }
      },
      "id": "7f7a4e4e-2b6b-4d2f-9d30-5f8a2f0e6c11",
      "name": "Every morning",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "url": "={{ $env.REACHPILOT_URL }}/api/cron/tick",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.REACHPILOT_CRON_SECRET }}"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      },
      "id": "9f1b5b39-6f34-4f0a-8c95-3b2f4f1a8b22",
      "name": "Run ReachPilot check",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [220, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "a5b8c2d1-0f6e-4a3b-9c7d-1e2f3a4b5c66",
              "leftValue": "={{ $json.ok }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "c4d7e3a2-1b8f-4c6d-8e9f-2a3b4c5d6e77",
      "name": "Did it run?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [460, 0]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "e5f8a1b2-3c4d-4e5f-8a9b-6c7d8e9f0a11",
              "name": "summary",
              "value": "=Replies found: {{ $json.result.repliesFound || 0 }} · Follow-ups sent: {{ $json.result.followUpsSent || 0 }} · Drafts created: {{ $json.result.draftsCreated || 0 }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "b2c3d4e5-f6a7-4b8c-9d0e-1f2a3b4c5d88",
      "name": "Daily summary",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [700, -80]
    },
    {
      "parameters": {},
      "id": "d8e9f0a1-b2c3-4d4e-8f5a-6b7c8d9e0f22",
      "name": "Check failed",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [700, 100]
    }
  ],
  "connections": {
    "Every morning": {
      "main": [
        [
          {
            "node": "Run ReachPilot check",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run ReachPilot check": {
      "main": [
        [
          {
            "node": "Did it run?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Did it run?": {
      "main": [
        [
          {
            "node": "Daily summary",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Check failed",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {},
  "meta": {
    "instanceId": "reachpilot-companion"
  }
}
